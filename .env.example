# Copie este arquivo para ".env" e preencha com os valores reais.
# O .env de verdade nunca é enviado pro GitHub (está no .gitignore).

# Connection string do Supabase: Project Settings > Database > Connection string.
# Use o modo "Transaction pooler" (porta 6543) para o back-end hospedado (Render/Railway/etc).
DATABASE_URL=postgresql+pg8000://postgres.xxxxxxxxxxxx:sua_senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

SECRET_KEY=troque_por_uma_chave_aleatoria_bem_grande_em_producao
ALGORITMO=HS256
TOKEN_EXPIRA_MINUTOS=60

# URLs do front-end que podem chamar essa API (separadas por vírgula)
ORIGENS_PERMITIDAS=http://localhost:5173,https://seu-projeto.vercel.app

# URL do front-end usada para montar o link de redefinição de senha no e-mail
# (deve ser a mesma URL que os usuários acessam, ex: https://seu-projeto.vercel.app)
FRONTEND_URL=http://localhost:5173

# Envio de e-mail transacional (redefinição de senha, notificações). Opcional: sem
# nenhuma das opções abaixo configuradas, o sistema so' loga a tentativa e segue normal.

# Opção 1 (recomendada -- única que funciona no Render): Brevo, via API HTTPS.
# O Render bloqueia conexões de saída em portas de SMTP (25/465/587), então Gmail SMTP puro
# (opção 2 abaixo) NUNCA funciona hospedado lá -- só localmente. A API do Brevo usa HTTPS
# normal (porta 443), que não é bloqueada.
# Criar em brevo.com (plano gratuito, 300 e-mails/dia). Em Settings > Senders, adicione e
# verifique o e-mail remetente (ex: seu Gmail -- chega um link de confirmação nele, não
# precisa ter domínio próprio). Depois gere a chave em Settings > SMTP & API > API Keys.
BREVO_API_KEY=
BREVO_REMETENTE_EMAIL=
BREVO_REMETENTE_NOME=CadaUm

# Opção 2: Gmail SMTP (usada só se o Brevo acima não estiver configurado). Funciona local,
# mas NÃO funciona no Render -- ver aviso acima. GMAIL_APP_PASSWORD precisa ser uma "Senha de
# app" do Google, NÃO a senha normal da conta (ative a verificação em duas etapas e gere em
# myaccount.google.com/apppasswords).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Opção 3: Resend (usada só se as duas acima não estiverem configuradas).
# Criar em resend.com (plano gratuito, 3000 e-mails/mes) e verificar um dominio remetente
# (precisa ser dono do domínio -- ao contrário do Brevo, não dá pra verificar só um e-mail).
RESEND_API_KEY=
